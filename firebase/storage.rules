rules_version = '2';

// Reglas de ConectaSur (Storage): fotos y logos en shops/{shopId}/...
service firebase.storage {
  match /b/{bucket}/o {

    function hasProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function canWriteShop(shopId) {
      return hasProfile() && profile().active == true
        && (profile().role == 'admin'
            || (profile().role == 'emprendedora' && profile().shopId == shopId));
    }
    // Solo imagenes de menos de 2 MB (las fotos se comprimen antes de subir).
    function isSmallImage() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canWriteShop(shopId) && isSmallImage();
      allow delete: if canWriteShop(shopId);
    }
  }
}

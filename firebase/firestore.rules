rules_version = '2';

// Reglas de ConectaSur (Firestore). Roles guardados en users/{uid}.role:
// 'admin' | 'emprendedora' | 'comprador'. Todo lo no mencionado queda DENEGADO.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function profile() { return get(profilePath()).data; }
    function isActive() { return hasProfile() && profile().active == true; }
    function isAdmin() { return isActive() && profile().role == 'admin'; }
    function isOwnerOf(shopId) {
      return isActive() && profile().role == 'emprendedora' && profile().shopId == shopId;
    }


    function shortText(value, limit) {
      return value is string && value.size() > 0 && value.size() <= limit;
    }
    function stock(value) {
      return value is int && value >= 0 && value <= 2147483647;
    }
    function price(value) { return value is int && value >= 0; }
    function validVariant(v) {
      return v is map && v.keys().hasOnly(['id', 'label', 'quantity'])
        && v.id is string && v.id.matches('.{1,120}')
        && v.label is string && v.label.matches('.{1,120}')
        && v.quantity is int && v.quantity >= 0 && v.quantity <= 2147483647;
    }
    // Rules no permite recorrer una lista: limite tecnico explicito de 10 opciones.
    function validVariants(v) {
      let n = v.size();
      return v is list && n <= 10
        && (n <= 0 || validVariant(v[0]))
        && (n <= 1 || validVariant(v[1]))
        && (n <= 2 || validVariant(v[2]))
        && (n <= 3 || validVariant(v[3]))
        && (n <= 4 || validVariant(v[4]))
        && (n <= 5 || validVariant(v[5]))
        && (n <= 6 || validVariant(v[6]))
        && (n <= 7 || validVariant(v[7]))
        && (n <= 8 || validVariant(v[8]))
        && (n <= 9 || validVariant(v[9]));
    }
    function validProduct(d, shopId, productId) {
      return d.keys().hasAll(['id', 'shopId', 'name', 'description', 'category',
          'priceClp', 'showPrice', 'stockMode', 'quantity', 'visible', 'photo', 'variants'])
        && d.keys().hasOnly(['id', 'shopId', 'name', 'description', 'category',
          'priceClp', 'showPrice', 'stockMode', 'quantity', 'visible', 'photo', 'variants', 'updatedAt'])
        && d.id == productId && d.shopId == shopId
        && shortText(d.name, 120)
        && d.description is string && d.description.size() <= 1000
        && d.category is string && d.category.size() <= 120
        && price(d.priceClp) && d.showPrice is bool && d.visible is bool
        && d.photo is string && d.photo.size() <= 2048
        && d.stockMode in ['UNITS', 'UNIQUE', 'ON_REQUEST']
        && ((d.stockMode == 'ON_REQUEST' && d.quantity == null) || stock(d.quantity))
        && (d.stockMode != 'UNIQUE' || (d.quantity <= 1 && d.variants.size() == 0))
        && validVariants(d.variants)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }
    function validSale(d) {
      return d.keys().hasAll(['productId', 'productName', 'variantId', 'quantity',
          'priceClp', 'place', 'dateMillis', 'createdAt'])
        && d.keys().hasOnly(['productId', 'productName', 'variantId', 'quantity',
          'priceClp', 'place', 'dateMillis', 'createdAt'])
        && shortText(d.productId, 120) && shortText(d.productName, 120)
        && (d.variantId == null || shortText(d.variantId, 120))
        && stock(d.quantity) && d.quantity > 0 && price(d.priceClp)
        && d.place is string && d.place.size() <= 240
        && d.dateMillis is int && d.dateMillis >= 0
        && d.createdAt is timestamp;
    }

    // Lo UNICO que puede tener un producto publico (sin stock, sin precio oculto).
    function validPublic(d, productId) {
      return d.keys().hasOnly(['id', 'shopId', 'name', 'description', 'category',
                               'priceClp', 'onRequest', 'photo', 'updatedAt'])
        && d.keys().hasAll(['id', 'shopId', 'name', 'onRequest'])
        && d.id == productId
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.onRequest is bool
        && (!('priceClp' in d) || d.priceClp == null || (d.priceClp is int && d.priceClp >= 0))
        && (!('description' in d) || d.description == null || (d.description is string && d.description.size() <= 1000));
    }

    // ---------- Usuarios y roles ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // El admin crea cuentas. Un comprador solo puede crear SU perfil como comprador.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['role', 'active', 'displayName'])
            && request.resource.data.role == 'comprador'
            && request.resource.data.active == true
            && (!('displayName' in request.resource.data)
                || (request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 120)));
      allow update, delete: if isAdmin();
    }

    // ---------- Tiendas ----------
    match /shops/{shopId} {
      allow read: if true;                       // la ficha de tienda es publica
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwnerOf(shopId)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'description', 'logoUrl', 'entrepreneurType',
                         'sector', 'contact', 'showPrices', 'updatedAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && (!('showPrices' in request.resource.data) || request.resource.data.showPrices is bool)
            && (!('description' in request.resource.data)
                || request.resource.data.description == null
                || (request.resource.data.description is string && request.resource.data.description.size() <= 1000)));

      // Catalogo PRIVADO (con stock): solo su dueña.
      match /products/{productId} {
        allow read, delete: if isOwnerOf(shopId);
        allow create, update: if isOwnerOf(shopId)
          && validProduct(request.resource.data, shopId, productId);
      }
      // Historial de ventas PRIVADO (RN-10): ni el admin lo ve.
      match /sales/{saleId} {
        allow read, delete: if isOwnerOf(shopId);
        allow create: if isOwnerOf(shopId) && validSale(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwnerOf(shopId) && validSale(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // ---------- Catalogo PUBLICO (copia sin datos privados) ----------
    match /publicProducts/{productId} {
      allow read: if true;
      allow create: if isOwnerOf(request.resource.data.shopId) && validPublic(request.resource.data, productId);
      allow update: if isOwnerOf(resource.data.shopId)
        && request.resource.data.shopId == resource.data.shopId
        && validPublic(request.resource.data, productId);
      allow delete: if resource == null || isOwnerOf(resource.data.shopId) || isAdmin();
    }

    // ---------- Listas que mantiene el administrador ----------
    match /associations/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /productTypes/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /entrepreneurTypes/{id}  { allow read: if true; allow write: if isAdmin(); }
  }
}

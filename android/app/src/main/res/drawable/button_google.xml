<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#DCEDE6" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="?attr/appInk" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#A85D17" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#728880" />
        </shape>
    </item>
</selector>

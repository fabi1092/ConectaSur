<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:theme="@style/Theme.ConectaSur">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <cl.surcode.conectasur.ConectaSurLogoView android:id="@+id/brand_logo" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginBottom="24dp" android:contentDescription="@string/brand_description" />
        <TextView android:id="@+id/welcome_title" style="@style/ConectaSur.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_title" />
        <TextView android:id="@+id/welcome_description" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_description" />
        <TextView android:id="@+id/demo_note" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo" />
        <TextView android:id="@+id/home_question" style="@style/ConectaSur.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_question" />
        <Button android:id="@+id/open_catalog" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/see_products" />
        <Button android:id="@+id/open_store" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_entry" android:drawableStart="@drawable/ic_store" />
        <Button android:id="@+id/buyer_demo_login" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buyer_demo_login" android:visibility="gone" />
        <Button android:id="@+id/buyer_cancel_login" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buyer_cancel_login" android:visibility="gone" />
        <TextView android:id="@+id/buyer_session_status" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/buyer_logout" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buyer_logout" android:visibility="gone" />
        <Button android:id="@+id/open_settings" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/accessibility" android:drawableStart="@drawable/ic_text" />
        <TextView android:id="@+id/community_name" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/community_name" />
    </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:theme="@style/Theme.ConectaSur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABECERA DE IDENTIDAD COMUNITARIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_surface_owner_header"
            android:orientation="vertical"
            android:padding="20dp">

            <cl.surcode.conectasur.ConectaSurLogoView
                android:id="@+id/brand_logo"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@string/brand_description" />

            <TextView
                android:id="@+id/community_name"
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/badge_pill_forest"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/community_name"
                android:textColor="@color/conectasur_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/welcome_title"
                style="@style/ConectaSur.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/welcome_title" />

            <TextView
                android:id="@+id/welcome_description"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/welcome_description" />

            <TextView
                android:id="@+id/demo_note"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:text="@string/demo" />
        </LinearLayout>

        <!-- BLOQUE 1: MODO COMPRADOR Y VITRINA LOCAL (RF-ACC-05) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/badge_pill_forest"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Modo comprador · Vitrina local"
                android:textColor="@color/conectasur_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_question"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="6dp"
                android:text="@string/home_question" />

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Explora el catálogo de emprendedoras de Alerce y Puerto Montt o busca directamente por rubro:" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/home_cat_tejidos"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Tejidos"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/home_cat_madera"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Madera"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/home_cat_reposteria"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Repostería"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/home_cat_conservas"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Conservas"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/open_catalog"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/see_products" />

            <TextView
                android:id="@+id/buyer_session_status"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <Button
                android:id="@+id/buyer_demo_login"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="0dp"
                android:text="@string/buyer_demo_login"
                android:visibility="gone" />

            <Button
                android:id="@+id/buyer_cancel_login"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="0dp"
                android:text="@string/buyer_cancel_login"
                android:visibility="gone" />

            <Button
                android:id="@+id/buyer_logout"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="0dp"
                android:text="@string/buyer_logout"
                android:visibility="gone" />
        </LinearLayout>

        <!-- BLOQUE 2: MODO EMPRENDEDORA Y ACCESO A CUENTA (RF-ACC-05) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_surface_owner_primary"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/badge_pill_forest"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Modo emprendedora · Cuenta y tienda"
                android:textColor="@color/conectasur_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="6dp"
                android:text="Tu tienda o cuenta personal" />

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Si eres emprendedora, administra tus productos y ventas. Si eres comprador, conéctate con Google para guardar tu perfil." />

            <Button
                android:id="@+id/open_store"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:drawableStart="@drawable/ic_store"
                android:text="@string/account_entry" />

            <LinearLayout
                android:id="@+id/home_owner_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/home_owner_manage_products"
                    style="@style/ConectaSur.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawableStart="@drawable/ic_products"
                    android:minHeight="52dp"
                    android:text="Mis productos (editar y crear)" />

                <Button
                    android:id="@+id/home_owner_sales"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="48dp"
                    android:text="Anotar una venta" />

                <Button
                    android:id="@+id/home_owner_history"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:text="Historial de ventas" />
            </LinearLayout>
        </LinearLayout>

        <!-- BLOQUE 3: ACCESIBILIDAD Y LECTURA FÁCIL (RNF-USA-01 a 03) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="6dp"
                android:text="Comodidad visual y voz" />

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Ajusta el tamaño de las letras, activa botones grandes o alto contraste según tu preferencia." />

            <Button
                android:id="@+id/open_settings"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:drawableStart="@drawable/ic_text"
                android:text="@string/accessibility" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

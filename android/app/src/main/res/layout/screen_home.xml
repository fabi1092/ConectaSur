<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- Cabecera ConectaSur + Modo actual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/photo_frame_bg"
                android:contentDescription="Logo ConectaSur"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/conectasur_logo" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="ConectaSur"
                android:textColor="?attr/appInk"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_forest"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Modo Comprador"
                android:textColor="@color/conectasur_forest_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Panel rápido Emprendedora -->
        <LinearLayout
            android:id="@+id/home_owner_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface_owner_header"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Panel de emprendedora" />

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Administra tus productos, ventas y ferias, o explora Productos abajo para ver otras tiendas." />

            <Button
                android:id="@+id/home_owner_products"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="52dp"
                android:text="Mis productos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_owner_sales"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="Registrar venta" />

                <Button
                    android:id="@+id/home_owner_history"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="Historial" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_owner_messages"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Mensajes" />

                <Button
                    android:id="@+id/home_owner_fairs"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Mis ferias" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hub Comprador / Visitante -->
        <LinearLayout
            android:id="@+id/home_buyer_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora productos locales, tiendas y ferias de Puerto Montt y Alerce." />

            <Button
                android:id="@+id/open_catalog"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="54dp"
                android:text="Explorar catálogo de productos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_open_stores"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Ver tiendas" />

                <Button
                    android:id="@+id/home_open_fairs"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Ver ferias" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vitrina rápida: máximo 2 destacados -->
        <LinearLayout
            android:id="@+id/home_featured_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_question"
                    style="@style/ConectaSur.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Destacados de hoy" />

                <TextView
                    android:id="@+id/home_products_count"
                    style="@style/ConectaSur.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 disponibles" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_product_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Textos ocultos para compatibilidad -->
        <TextView
            android:id="@+id/community_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feria y Emprendedoras del Sur"
            android:visibility="gone" />

        <TextView
            android:id="@+id/welcome_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explora productos hechos a mano, revisa disponibilidad real y organiza tu tienda de forma simple."
            android:visibility="gone" />

        <TextView
            android:id="@+id/demo_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Tu cuenta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu cuenta" />

            <TextView
                android:id="@+id/buyer_session_status"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Sin sesión iniciada" />

            <Button
                android:id="@+id/buyer_demo_login"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Ingresar como comprador" />

            <Button
                android:id="@+id/home_notifications_follows"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:minHeight="48dp"
                android:text="Avisos y tiendas seguidas" />

            <Button
                android:id="@+id/buyer_cancel_login"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Cancelar ingreso"
                android:visibility="gone" />

            <Button
                android:id="@+id/buyer_logout"
                style="@style/ConectaSur.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Cerrar sesión"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Acceso tienda y Ajustes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/open_store"
                style="@style/ConectaSur.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="Acceso tienda" />

            <Button
                android:id="@+id/open_settings"
                style="@style/ConectaSur.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="Ajustes" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

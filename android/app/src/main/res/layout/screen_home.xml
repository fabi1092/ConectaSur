<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- Top Brand + Mode Pill (Figma Screen 01) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/photo_frame_bg"
                android:contentDescription="Logo ConectaSur"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/conectasur_logo" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="ConectaSur"
                android:textColor="?attr/appInk"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_forest"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Modo Comprador"
                android:textColor="@color/conectasur_forest_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Pill + Voice Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/home_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Buscar en ConectaSur..."
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:textColor="?attr/appInk"
                android:textColorHint="?attr/appMuted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/home_voice_search"
                style="@style/ConectaSur.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="Buscar productos con la voz"
                android:paddingHorizontal="12dp"
                android:text="Voz" />
        </LinearLayout>

        <!-- Horizontal Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_cat_all"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Todas" />

                <Button
                    android:id="@+id/home_cat_tejidos"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Tejidos" />

                <Button
                    android:id="@+id/home_cat_madera"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Madera" />

                <Button
                    android:id="@+id/home_cat_reposteria"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Repostería" />

                <Button
                    android:id="@+id/home_cat_conservas"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conservas" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_question"
                style="@style/ConectaSur.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Productos locales" />

            <TextView
                android:id="@+id/home_products_count"
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 disponibles" />
        </LinearLayout>

        <!-- 2-Column Product Grid right on Inicio -->
        <LinearLayout
            android:id="@+id/home_product_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/open_catalog"
            style="@style/ConectaSur.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ver todo el catálogo" />

        <!-- Hidden legacy text views for accessibility/test compatibility -->
        <TextView
            android:id="@+id/community_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feria y Emprendedoras del Sur"
            android:visibility="gone" />

        <TextView
            android:id="@+id/welcome_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explora productos hechos a mano, revisa disponibilidad real y organiza tu tienda de forma simple."
            android:visibility="gone" />

        <TextView
            android:id="@+id/demo_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Entrepreneur / Owner Actions (shown when logged in as owner) -->
        <LinearLayout
            android:id="@+id/home_owner_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface_owner_header"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Panel de emprendedora" />

            <Button
                android:id="@+id/home_owner_manage_products"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Administrar productos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_owner_sales"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="Registrar venta" />

                <Button
                    android:id="@+id/home_owner_history"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="Historial" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buyer Session Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu cuenta" />

            <TextView
                android:id="@+id/buyer_session_status"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Sin sesión iniciada" />

            <Button
                android:id="@+id/buyer_demo_login"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Ingresar como comprador" />

            <Button
                android:id="@+id/buyer_cancel_login"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Cancelar ingreso"
                android:visibility="gone" />

            <Button
                android:id="@+id/buyer_logout"
                style="@style/ConectaSur.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Cerrar sesión"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Store Access & Settings Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/open_store"
                style="@style/ConectaSur.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:text="Acceso tienda" />

            <Button
                android:id="@+id/open_settings"
                style="@style/ConectaSur.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="Ajustes" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

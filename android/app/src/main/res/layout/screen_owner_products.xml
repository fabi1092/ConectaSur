<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_owner_products_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <Button
                android:id="@+id/pm_add"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/e5_screen_owner_products_1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pm_sales"
                    style="@style/ConectaSur.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_terracotta"
                    android:text="@string/e5_screen_owner_products_2"
                    android:textColor="@color/conectasur_surface"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/pm_history"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/e5_screen_owner_products_3"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/pm_preview"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/e5_screen_owner_products_4"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/pm_defaults"
                    style="@style/ConectaSur.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/e5_screen_owner_products_5"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pm_search"
                    android:text="@string/e5_screen_owner_products_7" />

                <EditText
                    android:id="@+id/pm_search"
                    style="@style/ConectaSur.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Escribe nombre o categoría"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:saveEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pm_bulk"
                        style="@style/ConectaSur.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/e5_screen_owner_products_8"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/pm_more_options"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="Más opciones"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/pm_refresh"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/e5_screen_owner_products_6"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pm_bulk_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/pm_bulk_apply"
                        style="@style/ConectaSur.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="Cambiar selección"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/pm_bulk_cancel"
                        style="@style/ConectaSur.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:text="Listo"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/pm_summary"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="10dp"
                android:text="@string/e5_screen_owner_products_9" />

            <LinearLayout
                android:id="@+id/pm_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

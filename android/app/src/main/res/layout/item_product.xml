<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <cl.surcode.conectasur.ui.ProductPhotoView
        android:id="@+id/product_photo"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:background="@drawable/photo_frame_bg"
        android:clipToOutline="true"
        android:contentDescription="Foto del producto"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/product_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/badge_pill_forest"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Categoría"
        android:textColor="@color/conectasur_forest_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:minLines="2"
        android:text="Nombre del producto"
        android:textColor="?attr/appInk"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/product_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:text="$0"
        android:textColor="@color/conectasur_forest_dark"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/product_availability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Disponible"
        android:textColor="?attr/appMuted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/open_product"
        style="@style/ConectaSur.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ver producto"
        android:visibility="gone" />
</LinearLayout>

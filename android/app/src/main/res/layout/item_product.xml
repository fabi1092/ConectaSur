<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/card_surface"
    android:orientation="vertical"
    android:padding="16dp"
    android:screenReaderFocusable="true">

    <cl.surcode.conectasur.ui.ProductPhotoView
        android:id="@+id/product_photo"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/photo_description"
        android:scaleType="centerCrop"
        android:src="@drawable/flores" />

    <TextView
        android:id="@+id/product_category"
        style="@style/ConectaSur.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/product_category" />

    <TextView
        android:id="@+id/product_name"
        style="@style/ConectaSur.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/product_name" />

    <TextView
        android:id="@+id/product_price"
        style="@style/ConectaSur.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:text="@string/product_price" />

    <TextView
        android:id="@+id/product_availability"
        style="@style/ConectaSur.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/available" />

    <Button
        android:id="@+id/open_product"
        style="@style/ConectaSur.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/open_product" />
</LinearLayout>

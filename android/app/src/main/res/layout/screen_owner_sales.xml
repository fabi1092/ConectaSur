<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_owner_sales_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/sv_undo_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sv_undo_text"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Te equivocaste al anotar la venta? Puedes anularla y devolver las unidades."
                    android:textColor="@color/conectasur_amber"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sv_undo_button"
                    style="@style/ConectaSur.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="Anular última venta" />
            </LinearLayout>

            <!-- Step 1: Seleccionar producto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sv_heading"
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/e5_screen_owner_sales_1"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sv_product_label"
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="1. Seleccionar producto" />

                <LinearLayout
                    android:id="@+id/sv_product_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Spinner
                    android:id="@+id/sv_product"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_field"
                    android:contentDescription="@string/e5_screen_owner_sales_3"
                    android:minHeight="52dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Step 2: Tocar variante -->
            <LinearLayout
                android:id="@+id/sv_variant_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sv_variant_label"
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="2. Tocar variante" />

                <HorizontalScrollView
                    android:id="@+id/sv_variant_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sv_variant_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Spinner
                    android:id="@+id/sv_variant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_field"
                    android:contentDescription="@string/e5_screen_owner_sales_5"
                    android:minHeight="52dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Step 3: Cantidad vendida -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:labelFor="@id/sv_quantity"
                    android:text="3. Cantidad vendida" />

                <LinearLayout
                    android:id="@+id/sv_quantity_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/sv_qty_minus"
                        style="@style/ConectaSur.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="- Quitar" />

                    <EditText
                        android:id="@+id/sv_quantity"
                        android:layout_width="72dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@android:color/transparent"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:saveEnabled="false"
                        android:textColor="?attr/appInk"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/sv_qty_plus"
                        style="@style/ConectaSur.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="+ Sumar" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 4: Lugar de venta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="4. Lugar de venta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/sv_place_feria"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="Feria" />

                    <Button
                        android:id="@+id/sv_place_particular"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="Particular" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/sv_fair_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/input_field"
                    android:contentDescription="Elegir feria de la plataforma u otro lugar"
                    android:minHeight="52dp" />

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/sv_place"
                    android:text="@string/e5_screen_owner_sales_7" />

                <EditText
                    android:id="@+id/sv_place"
                    style="@style/ConectaSur.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:hint="Ej: Feria Costanera o Taller"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:saveEnabled="false" />
            </LinearLayout>

            <!-- Total calculado + Guardar venta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/status_banner_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sv_price"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/e5_screen_owner_sales_8"
                    android:textColor="@color/conectasur_forest_dark"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sv_register"
                    style="@style/ConectaSur.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:minHeight="56dp"
                    android:text="Guardar venta" />
            </LinearLayout>

            <TextView
                android:id="@+id/sv_note"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/e5_screen_owner_sales_10" />

            <Button
                android:id="@+id/sv_history"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/e5_screen_owner_sales_11" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:theme="@style/Theme.ConectaSur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Cabecera compacta de marca y estado de exploración -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <cl.surcode.conectasur.ConectaSurLogoView
                android:id="@+id/catalog_brand_logo"
                android:layout_width="136dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/brand_description" />

            <TextView
                android:id="@+id/catalog_mode"
                style="@style/ConectaSur.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/badge_pill_forest"
                android:gravity="center"
                android:layout_marginBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/buyer_public_mode"
                android:textColor="@color/conectasur_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AVISO / ACCESO DIRECTO PARA EMPRENDEDORA (ISSUE 2) -->
        <LinearLayout
            android:id="@+id/catalog_owner_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_surface_owner_primary"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Estás viendo la vitrina pública de clientes. Para crear o editar tus productos, ve a Mis productos:"
                android:textColor="@color/conectasur_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/catalog_go_to_manager"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_products"
                android:minHeight="48dp"
                android:text="Mis productos (editar y crear)" />
        </LinearLayout>

        <TextView
            android:id="@+id/page_title"
            style="@style/ConectaSur.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/catalog_title"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/catalog_intro"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/catalog_intro"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/catalog_status"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <!-- Barra de búsqueda integrada estilo marketplace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/search_label"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:labelFor="@id/search_input"
                android:text="@string/search_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/input_field"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapSentences"
                    android:minHeight="56dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:singleLine="true"
                    android:textColor="@color/conectasur_ink"
                    android:textColorHint="#4D655F"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/voice_search"
                    style="@style/ConectaSur.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:minHeight="56dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Por voz"
                    android:contentDescription="Buscar productos con la voz" />
            </LinearLayout>

            <Button
                android:id="@+id/clear_search"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:text="@string/clear_search"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/results_count"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/empty_catalog"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/product_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/empty_message"
            style="@style/ConectaSur.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:padding="20dp"
            android:text="@string/empty_search"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

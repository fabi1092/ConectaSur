<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- Compact Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/catalog_brand_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/photo_frame_bg"
                android:contentDescription="Logo ConectaSur"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/conectasur_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/page_title"
                    style="@style/ConectaSur.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/catalog_title" />

                <TextView
                    android:id="@+id/catalog_mode"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Catálogo público" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/catalog_intro"
            style="@style/ConectaSur.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/catalog_intro" />

        <!-- Owner Preview Banner (when previewing as owner) -->
        <LinearLayout
            android:id="@+id/catalog_owner_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/status_banner_bg"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estás viendo tu tienda como la ve el público."
                android:textStyle="bold" />

            <Button
                android:id="@+id/catalog_go_to_manager"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Volver a mis productos" />
        </LinearLayout>

        <!-- Mercado Libre-style Search Pill Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/search_label"
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/search_input"
                android:text="@string/search_label"
                android:visibility="gone" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="Buscar en ConectaSur..."
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:textColor="?attr/appInk"
                android:textColorHint="?attr/appMuted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/voice_search"
                style="@style/ConectaSur.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="Buscar productos con la voz"
                android:paddingHorizontal="12dp"
                android:text="Voz" />
        </LinearLayout>

        <Button
            android:id="@+id/clear_search"
            style="@style/ConectaSur.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/clear_search"
            android:visibility="gone" />

        <!-- Status & Count -->
        <TextView
            android:id="@+id/catalog_status"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/results_count"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/empty_catalog"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/product_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/empty_message"
            style="@style/ConectaSur.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:padding="@dimen/space_lg"
            android:text="@string/empty_search"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

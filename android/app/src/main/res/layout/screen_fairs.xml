<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    tools:theme="@style/Theme.ConectaSur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/page_title"
                    style="@style/ConectaSur.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Próximas ferias" />

                <TextView
                    android:id="@+id/fairs_subtitle"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puerto Montt y Alerce" />
            </LinearLayout>

            <TextView
                android:id="@+id/fairs_gps_badge"
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_forest"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Ordenado por fecha" />
        </LinearLayout>

        <Button
            android:id="@+id/fairs_enable_gps"
            style="@style/ConectaSur.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="48dp"
            android:text="Activar ubicación cercana" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface">

            <WebView
                android:id="@+id/fairs_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/fairs_status"
            style="@style/ConectaSur.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Cargando ferias..." />

        <LinearLayout
            android:id="@+id/fairs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>


<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:theme="@style/Theme.ConectaSur">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <cl.surcode.conectasur.ui.ProductPhotoView android:id="@+id/product_photo" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginBottom="20dp" android:scaleType="centerCrop" android:contentDescription="@string/photo_description" android:src="@drawable/flores" />
        <TextView android:id="@+id/product_category" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/product_category" />
        <TextView android:id="@+id/page_title" style="@style/ConectaSur.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/product_name" />
        <TextView android:id="@+id/product_price" style="@style/ConectaSur.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/product_price" />
        <TextView android:id="@+id/product_availability" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/available" />
        <TextView android:id="@+id/price_note" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/price_example" />
        <TextView android:id="@+id/about_product" style="@style/ConectaSur.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_product" />
        <TextView android:id="@+id/product_description" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/product_description" />
        <TextView android:id="@+id/photo_note" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/photo_note" />
        <Button android:id="@+id/view_store" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/view_store" />
        <Button android:id="@+id/share_product" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_product" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    tools:theme="@style/Theme.ConectaSur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- Hero Photo -->
        <cl.surcode.conectasur.ui.ProductPhotoView
            android:id="@+id/product_photo"
            android:layout_width="match_parent"
            android:layout_height="248dp"
            android:background="@drawable/photo_frame_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/photo_description"
            android:scaleType="centerCrop"
            android:src="@drawable/flores" />

        <!-- Core Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/product_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_pill_forest"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/product_category"
                    android:textColor="@color/conectasur_forest_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/product_availability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/available"
                    android:textColor="?attr/appMuted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/page_title"
                style="@style/ConectaSur.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/product_name" />

            <TextView
                android:id="@+id/product_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:fontFeatureSettings="tnum"
                android:text="@string/product_price"
                android:textColor="@color/conectasur_forest_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/price_note"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/price_example" />

            <TextView
                android:id="@+id/public_variant_label"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Opciones disponibles"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/public_variant_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/public_variant_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <Spinner
                android:id="@+id/public_variant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/input_field"
                android:contentDescription="Elegir variante del producto"
                android:minHeight="56dp"
                android:paddingHorizontal="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Description & Attributes Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/about_product"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_product" />

            <TextView
                android:id="@+id/product_description"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/product_description" />

            <TextView
                android:id="@+id/product_attributes_title"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Características del producto"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/product_specs_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/product_attributes"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/photo_note"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/photo_note" />
        </LinearLayout>

        <!-- Actions (Figma Screen 02 side-by-side) -->
        <Button
            android:id="@+id/contact_product"
            style="@style/ConectaSur.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="48dp"
            android:text="Contactar a la tienda"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <Button
                android:id="@+id/view_store"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1.3"
                android:text="@string/view_store" />

            <Button
                android:id="@+id/share_product"
                style="@style/ConectaSur.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/share_product" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

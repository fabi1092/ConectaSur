<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_owner_defaults_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp"
                    android:text="Valores por defecto de productos" />

                <TextView
                    android:id="@+id/pd_mode_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_owner_defaults_1" />

                <Spinner
                    android:id="@+id/pd_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/input_field"
                    android:contentDescription="@string/e5_screen_owner_defaults_2"
                    android:minHeight="52dp" />

                <TextView
                    android:id="@+id/pd_soldout_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_owner_defaults_3" />

                <Spinner
                    android:id="@+id/pd_soldout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/input_field"
                    android:contentDescription="@string/e5_screen_owner_defaults_4"
                    android:minHeight="52dp" />

                <CheckBox
                    android:id="@+id/pd_visible"
                    style="@style/ConectaSur.Check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_owner_defaults_5" />

                <CheckBox
                    android:id="@+id/pd_price"
                    style="@style/ConectaSur.Check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_owner_defaults_6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:text="Historial de ventas" />

                <CheckBox
                    android:id="@+id/pd_history"
                    style="@style/ConectaSur.Check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_owner_defaults_7" />

                <TextView
                    android:id="@+id/pd_note"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="@string/e5_screen_owner_defaults_8" />
            </LinearLayout>

            <Button
                android:id="@+id/pd_save"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/e5_screen_owner_defaults_9" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

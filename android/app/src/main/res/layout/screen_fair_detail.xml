<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <ImageView
            android:id="@+id/fair_detail_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/photo_frame_bg"
            android:contentDescription="Fotografía de la feria"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/fair_detail_status"
                style="@style/ConectaSur.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_forest"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Feria confirmada"
                android:textColor="@color/conectasur_forest_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/page_title"
                style="@style/ConectaSur.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Detalle de feria" />

            <TextView
                android:id="@+id/fair_detail_description"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fair_detail_meta"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fair_detail_share"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Compartir enlace" />

                <Button
                    android:id="@+id/fair_detail_qr"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Código QR" />
            </LinearLayout>

            <Button
                android:id="@+id/fair_detail_directions"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="48dp"
                android:text="Cómo llegar en mapa" />
        </LinearLayout>

        <TextView
            style="@style/ConectaSur.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Participantes confirmadas" />

        <LinearLayout
            android:id="@+id/fair_detail_participants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical" />

        <TextView
            style="@style/ConectaSur.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Ubicación en el mapa" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/card_surface">

            <WebView
                android:id="@+id/fair_detail_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>

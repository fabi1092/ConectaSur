<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/back_button"
                style="@style/ConectaSur.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:drawableStart="@drawable/ic_back"
                android:paddingHorizontal="10dp"
                android:text="@string/back"
                android:visibility="gone" />

            <Button
                android:id="@+id/read_button"
                style="@style/ConectaSur.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_speaker"
                android:paddingHorizontal="10dp"
                android:text="@string/listen" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/notifications_bell_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/notifications_bell"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_outline"
                    android:contentDescription="Centro de avisos"
                    android:scaleType="center"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:id="@+id/notifications_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingHorizontal="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/main_account"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:minHeight="48dp"
                android:minWidth="104dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/account_entry"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appBorder" />

        <FrameLayout
            android:id="@+id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/screen_home" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/normal_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nav_bar_surface"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/nav_home"
                style="@style/ConectaSur.NavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_home"
                android:paddingHorizontal="2dp"
                android:text="@string/home"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_catalog"
                style="@style/ConectaSur.NavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_products"
                android:paddingHorizontal="2dp"
                android:text="@string/products"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_stores"
                style="@style/ConectaSur.NavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_store"
                android:paddingHorizontal="2dp"
                android:text="Tiendas"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_fairs"
                style="@style/ConectaSur.NavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_location"
                android:paddingHorizontal="2dp"
                android:text="Ferias"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nav_help"
                style="@style/ConectaSur.NavButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_help"
                android:paddingHorizontal="2dp"
                android:text="@string/help"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/large_menu"
            style="@style/ConectaSur.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/menu"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/app_lock_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackground"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/app_lock_title"
                    style="@style/ConectaSur.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ConectaSur bloqueado" />

                <TextView
                    android:id="@+id/app_lock_status"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="Usa tu huella digital para entrar." />

                <Button
                    android:id="@+id/app_lock_unlock"
                    style="@style/ConectaSur.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="Desbloquear con huella" />

                <Button
                    android:id="@+id/app_lock_password"
                    style="@style/ConectaSur.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Ingresar con contraseña" />

                <Button
                    android:id="@+id/app_lock_public"
                    style="@style/ConectaSur.Button.Compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Ver catálogo público" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

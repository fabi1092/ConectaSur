<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:id="@+id/account_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <Button android:id="@+id/account_back" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/go_home"/>
            <TextView android:id="@+id/account_title" style="@style/ConectaSur.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_title"/>
            <TextView android:id="@+id/account_status" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
            <ProgressBar android:id="@+id/account_progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
            <LinearLayout android:id="@+id/login_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_intro"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_email" android:labelFor="@id/account_email"/>
                <EditText android:id="@+id/account_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:maxLines="1" android:maxLength="254" android:imeOptions="actionNext"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_password" android:labelFor="@id/account_password"/>
                <EditText android:id="@+id/account_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" android:maxLines="1" android:imeOptions="actionDone"/>
                <CheckBox android:id="@+id/account_show_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:text="@string/show_password" android:saveEnabled="false"/>
                <Button android:id="@+id/account_login" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_button"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/account_locked" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/account_unlock" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bio_unlock"/>
                <Button android:id="@+id/account_use_password" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bio_password"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/shop_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><Button android:id="@+id/shop_products" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mis productos"/>
<Button android:id="@+id/shop_register_sale" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar una venta"/>
<Button android:id="@+id/shop_history" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Historial de ventas"/>

                <TextView android:id="@+id/shop_account" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/shop_associations" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
                <Button android:id="@+id/shop_associations_retry" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_associations_retry" android:visibility="gone"/>
                <ImageView android:id="@+id/shop_edit_logo" android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_shop_logo" android:contentDescription="@string/store_logo"/>
                <Button android:id="@+id/shop_choose_logo" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/change_logo"/>
                <Button android:id="@+id/shop_remove_logo" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remove_logo"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/logo_save_note"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_name_label" android:labelFor="@id/shop_edit_name"/>
                <EditText android:id="@+id/shop_edit_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="textCapSentences" android:maxLength="120" android:saveEnabled="false" android:importantForAutofill="no"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_description_label" android:labelFor="@id/shop_edit_description"/>
                <EditText android:id="@+id/shop_edit_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="112dp" android:gravity="top" android:textSize="18sp" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000" android:saveEnabled="false" android:importantForAutofill="no"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_type_label" android:labelFor="@id/shop_edit_type"/>
                <EditText android:id="@+id/shop_edit_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="textCapSentences" android:maxLength="120" android:saveEnabled="false" android:importantForAutofill="no"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_sector_label" android:labelFor="@id/shop_edit_sector"/>
                <EditText android:id="@+id/shop_edit_sector" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="textCapSentences" android:maxLength="240" android:saveEnabled="false" android:importantForAutofill="no"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_contact_label" android:labelFor="@id/shop_edit_contact"/>
                <EditText android:id="@+id/shop_edit_contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="text" android:maxLength="240" android:saveEnabled="false" android:importantForAutofill="no"/>
                <CheckBox android:id="@+id/shop_show_prices" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:text="@string/shop_prices_label" android:saveEnabled="false"/>
                <Button android:id="@+id/shop_save" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_shop"/>
                <TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bio_intro"/>
                <TextView android:id="@+id/shop_bio_status" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/shop_bio_toggle" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bio_enable"/>
            </LinearLayout>
            <Button android:id="@+id/shop_reload" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reload_shop" android:visibility="gone"/>
            <Button android:id="@+id/account_logout" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/logout_button" android:visibility="gone"/>
            <Button android:id="@+id/account_read" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/store_read"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

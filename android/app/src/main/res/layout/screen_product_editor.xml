ayout_width="match_parent" android:layout_height="wrap_content" android:text="Modalidad y manejo de stock" /><Spinner android:id="@+id/pe_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:contentDescription="Modalidad y manejo de stock" /><TextView style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Unidades disponibles" android:labelFor="@id/pe_quantity" /><EditText android:id="@+id/pe_quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="18sp" android:inputType="number" android:maxLength="1000" android:saveEnabled="false" /><TextView android:id="@+id/pe_soldout_label" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cuando se agote" /><Spinner android:id="@+id/pe_soldout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:contentDescription="Cuando se agote" /><CheckBox android:id="@+id/pe_visible" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disponible en el catálogo público" /><CheckBox android:id="@+id/pe_show_price" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mostrar precio" /><TextView android:id="@+id/pe_review" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisa los datos antes de guardar" /></LinearLayout><Button android:id="@+id/pe_previous" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Paso anterior" /><Button android:id="@+id/pe_next" style="@style/ConectaSur.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_con
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/pe_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_product_editor_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/pe_step"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/e5_screen_product_editor_1" />

            <TextView
                android:id="@+id/pe_draft_status"
                style="@style/ConectaSur.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/e5_screen_product_editor_2" />

            <!-- PASO 1: FOTO PRINCIPAL -->
            <LinearLayout
                android:id="@+id/pe_step_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pe_photo_help"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/e5_screen_product_editor_3" />

                <ImageView
                    android:id="@+id/pe_photo"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_surface"
                    android:contentDescription="@string/e5_screen_product_editor_4"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_products" />

                <Button
                    android:id="@+id/pe_camera"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="56dp"
                    android:text="@string/e5_screen_product_editor_5" />

                <Button
                    android:id="@+id/pe_gallery"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:minHeight="56dp"
                    android:text="@string/e5_screen_product_editor_6" />

                <TextView
                    android:id="@+id/pe_photo_status"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/e5_screen_product_editor_7" />
            </LinearLayout>

            <!-- PASO 2: DATOS DEL PRODUCTO, RUBRO Y PRECIO -->
            <LinearLayout
                android:id="@+id/pe_step_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pe_name"
                    android:text="@string/e5_screen_product_editor_8" />

                <EditText
                    android:id="@+id/pe_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. Mermelada casera de murtilla"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/pe_dictate"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:minHeight="52dp"
                    android:text="@string/e5_screen_product_editor_9" />

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pe_description"
                    android:text="@string/e5_screen_product_editor_10" />

                <EditText
                    android:id="@+id/pe_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cuenta cómo está elaborado, los materiales o cómo se usa"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textSize="18sp" />

                <!-- RUBRO Y TIPO (UNIFICADO) -->
                <TextView
                    android:id="@+id/pe_type_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rubro del producto" />

                <Spinner
                    android:id="@+id/pe_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/e5_screen_product_editor_15"
                    android:minHeight="56dp" />

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pe_category"
                    android:text="Categoría o detalle del rubro" />

                <EditText
                    android:id="@+id/pe_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Se completa según el rubro o escribe una personalizada"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/pe_attributes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- PRECIO -->
                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@id/pe_price"
                    android:text="@string/e5_screen_product_editor_13" />

                <EditText
                    android:id="@+id/pe_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:hint="0"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pe_price_words"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:text="Escribe el precio o usa los botones de billetes (+ $500, + $1.000, + $5.000)." />

                <LinearLayout
                    android:id="@+id/pe_quick_bills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp">

                    <Button
                        android:id="@+id/pe_add_500"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="+ $500" />

                    <Button
                        android:id="@+id/pe_add_1000"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="+ $1.000" />

                    <Button
                        android:id="@+id/pe_add_5000"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="+ $5.000" />
                </LinearLayout>
            </LinearLayout>

            <!-- PASO 3: VARIANTES (OPCIONALES) -->
            <LinearLayout
                android:id="@+id/pe_step_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pe_variant_help"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/e5_screen_product_editor_16" />

                <Button
                    android:id="@+id/pe_add_variant"
                    style="@style/ConectaSur.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:minHeight="56dp"
                    android:text="@string/e5_screen_product_editor_17" />

                <LinearLayout
                    android:id="@+id/pe_variants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- PASO 4: DISPONIBILIDAD Y STOCK -->
            <LinearLayout
                android:id="@+id/pe_step_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pe_mode_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_product_editor_18" />

                <Spinner
                    android:id="@+id/pe_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/e5_screen_product_editor_19"
                    android:minHeight="56dp" />

                <TextView
                    android:id="@+id/pe_quantity_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pe_quantity"
                    android:text="@string/e5_screen_product_editor_20" />

                <EditText
                    android:id="@+id/pe_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pe_quantity_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp">

                    <Button
                        android:id="@+id/pe_qty_minus"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="- 1 unidad" />

                    <Button
                        android:id="@+id/pe_qty_plus"
                        style="@style/ConectaSur.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="+ 1 unidad" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pe_soldout_label"
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/e5_screen_product_editor_21" />

                <Spinner
                    android:id="@+id/pe_soldout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/e5_screen_product_editor_22"
                    android:minHeight="56dp" />

                <CheckBox
                    android:id="@+id/pe_visible"
                    style="@style/ConectaSur.Check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/e5_screen_product_editor_23" />

                <CheckBox
                    android:id="@+id/pe_show_price"
                    style="@style/ConectaSur.Check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/e5_screen_product_editor_24" />
            </LinearLayout>

            <!-- PASO 5: RESUMEN Y PUBLICACION -->
            <LinearLayout
                android:id="@+id/pe_step_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Revisa la ficha antes de publicar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/pe_summary_photo"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/card_surface"
                        android:contentDescription="Foto del producto a publicar"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_products" />

                    <TextView
                        android:id="@+id/pe_summary_name"
                        style="@style/ConectaSur.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/pe_summary_category_price"
                        style="@style/ConectaSur.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/conectasur_forest"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pe_summary_description"
                        style="@style/ConectaSur.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/pe_summary_mode"
                        style="@style/ConectaSur.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/pe_summary_variants_title"
                        style="@style/ConectaSur.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp"
                        android:text="Opciones / Variantes:"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/pe_summary_variants_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pe_review"
                    style="@style/ConectaSur.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/e5_screen_product_editor_25" />
            </LinearLayout>

            <!-- BOTONES DE NAVEGACION: SIGUIENTE / PUBLICAR ARRIBA, VOLVER ABAJO (ISSUE 7) -->
            <Button
                android:id="@+id/pe_next"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="56dp"
                android:text="@string/e5_screen_product_editor_27" />

            <Button
                android:id="@+id/pe_save"
                style="@style/ConectaSur.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="56dp"
                android:text="@string/e5_screen_product_editor_28"
                android:visibility="gone" />

            <Button
                android:id="@+id/pe_previous"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="56dp"
                android:text="@string/e5_screen_product_editor_26" />

            <Button
                android:id="@+id/pe_discard"
                style="@style/ConectaSur.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/e5_screen_product_editor_29" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    tools:theme="@style/Theme.ConectaSur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/page_title"
            style="@style/ConectaSur.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            android:id="@+id/settings_intro"
            style="@style/ConectaSur.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_intro" />

        <!-- Text Size Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/text_size"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_size" />

            <RadioGroup
                android:id="@+id/text_size_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/text_normal"
                    style="@style/ConectaSur.Option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/normal" />

                <RadioButton
                    android:id="@+id/text_large"
                    style="@style/ConectaSur.Option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/large" />

                <RadioButton
                    android:id="@+id/text_very_large"
                    style="@style/ConectaSur.Option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/very_large" />
            </RadioGroup>

            <TextView
                android:id="@+id/system_text"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/system_text" />
        </LinearLayout>

        <!-- Display & Touch Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <Switch
                android:id="@+id/big_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="12dp"
                android:text="@string/big_buttons"
                android:textColor="?attr/appInk"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/high_contrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingVertical="12dp"
                android:text="@string/high_contrast"
                android:textColor="?attr/appInk"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Reading Speed Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/reading_speed"
                style="@style/ConectaSur.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reading_speed" />

            <RadioGroup
                android:id="@+id/speed_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/speed_normal"
                    style="@style/ConectaSur.Option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/normal_speed" />

                <RadioButton
                    android:id="@+id/speed_slow"
                    style="@style/ConectaSur.Option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/slow_speed" />
            </RadioGroup>

            <TextView
                android:id="@+id/voice_note"
                style="@style/ConectaSur.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/voice_note" />

            <Button
                android:id="@+id/try_voice"
                style="@style/ConectaSur.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/try_voice" />
        </LinearLayout>

        <Button
            android:id="@+id/reset_settings"
            style="@style/ConectaSur.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/reset_settings" />
    </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" tools:theme="@style/Theme.ConectaSur">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/page_title" style="@style/ConectaSur.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" />
        <TextView android:id="@+id/settings_intro" style="@style/ConectaSur.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_intro" />
        <TextView android:id="@+id/text_size" style="@style/ConectaSur.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_size" />
        <RadioGroup android:id="@+id/text_size_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/text_normal" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/normal" />
            <RadioButton android:id="@+id/text_large" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/large" />
            <RadioButton android:id="@+id/text_very_large" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/very_large" />
        </RadioGroup>
        <TextView android:id="@+id/system_text" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_text" />
        <Switch android:id="@+id/big_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="18sp" android:textColor="?attr/appInk" android:text="@string/big_buttons" />
        <Switch android:id="@+id/high_contrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="18sp" android:textColor="?attr/appInk" android:text="@string/high_contrast" />
        <TextView android:id="@+id/reading_speed" style="@style/ConectaSur.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reading_speed" />
        <RadioGroup android:id="@+id/speed_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/speed_normal" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/normal_speed" />
            <RadioButton android:id="@+id/speed_slow" style="@style/ConectaSur.Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/slow_speed" />
        </RadioGroup>
        <TextView android:id="@+id/voice_note" style="@style/ConectaSur.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voice_note" />
        <Button android:id="@+id/try_voice" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/try_voice" />
        <Button android:id="@+id/reset_settings" style="@style/ConectaSur.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset_settings" />
    </LinearLayout>
</ScrollView>
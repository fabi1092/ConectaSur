<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/screen_owner_history_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/sh_heading"
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/e5_screen_owner_history_1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ConectaSur.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/sh_from"
                            android:text="@string/e5_screen_owner_history_2" />

                        <EditText
                            android:id="@+id/sh_from"
                            style="@style/ConectaSur.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Elegir fecha"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="1000"
                            android:saveEnabled="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ConectaSur.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/sh_to"
                            android:text="@string/e5_screen_owner_history_3" />

                        <EditText
                            android:id="@+id/sh_to"
                            style="@style/ConectaSur.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Elegir fecha"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="1000"
                            android:saveEnabled="false" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feria de la plataforma" />

                <Spinner
                    android:id="@+id/sh_fair_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/input_field"
                    android:contentDescription="Filtrar por feria de la plataforma"
                    android:minHeight="52dp" />

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/sh_place"
                    android:text="@string/e5_screen_owner_history_4" />

                <EditText
                    android:id="@+id/sh_place"
                    style="@style/ConectaSur.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: Feria Costanera"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:saveEnabled="false" />

                <TextView
                    style="@style/ConectaSur.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/sh_product"
                    android:text="@string/e5_screen_owner_history_5" />

                <EditText
                    android:id="@+id/sh_product"
                    style="@style/ConectaSur.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre del producto"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="1000"
                    android:saveEnabled="false" />

                <Button
                    android:id="@+id/sh_filter"
                    style="@style/ConectaSur.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="@string/e5_screen_owner_history_6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_surface_owner_header"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/sh_summary"
                    style="@style/ConectaSur.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/e5_screen_owner_history_7"
                    android:textColor="@color/conectasur_forest" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sh_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical"
                android:padding="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

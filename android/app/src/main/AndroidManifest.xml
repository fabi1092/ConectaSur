<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <queries><intent><action android:name="android.intent.action.TTS_SERVICE"/></intent></queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:supportsRtl="true" android:usesCleartextTraffic="false"
        android:label="ConectaSur" android:icon="@drawable/ic_launcher" android:theme="@style/Theme.ConectaSur">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/product_photo_paths"/></provider>
        <activity android:name=".ProductManagerActivity" android:exported="false"/>
        <activity android:name=".ProductEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".SalesActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".StoreActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="conectasur" android:host="auth" android:path="/callback"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
